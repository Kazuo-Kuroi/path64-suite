#ifdef _RWSTD_CXX11
// Bridge the existing raw segmented map to allocator_traits and fancy pointers.
template <class _Allocator, class _Tp>
struct __rw_deque_allocator {
    typedef typename allocator_traits<_Allocator>::template rebind_alloc<_Tp> _Alloc;
    typedef allocator_traits<_Alloc> _Traits;
    typedef _Tp* pointer;
    _Alloc _C_alloc;
    explicit __rw_deque_allocator (const _Allocator& __a) : _C_alloc (__a) { }
    pointer allocate (typename _Traits::size_type __n, const void* = 0) {
        return __rw_c11::__raw_address (_Traits::allocate (_C_alloc, __n));
    }
    void deallocate (pointer __p, typename _Traits::size_type __n) {
        if (__p) _Traits::deallocate (_C_alloc,
            pointer_traits<typename _Traits::pointer>::pointer_to (*__p), __n);
    }
    template <class... _Args> void construct (pointer __p, _Args&&... __args) {
        _Traits::construct (_C_alloc, __p, std::forward<_Args>(__args)...);
    }
    void destroy (pointer __p) { _Traits::destroy (_C_alloc, __p); }
    typename _Traits::size_type max_size () const { return _Traits::max_size (_C_alloc); }
};
#endif

_EXPORT
template <class _TypeT, class _Allocator = allocator<_TypeT> >
class deque;


template <class _TypeT, class _DiffT, class _Pointer,
          class _Reference, class _Allocator>
class __rw_deque_iter
    : public iterator <random_access_iterator_tag, _TypeT, _DiffT,
                       _Pointer, _Reference>
{
    typedef iterator <bidirectional_iterator_tag, _TypeT, _DiffT,
                      _Pointer, _Reference>           _C_iter_base;
public:

    typedef _Allocator                               allocator_type;
#ifdef _RWSTD_CXX11
    typedef typename allocator_traits<allocator_type>::size_type size_type;
#else
    typedef typename allocator_type::size_type      size_type;
#endif
    typedef typename _C_iter_base::value_type       value_type;
    typedef typename _C_iter_base::difference_type  difference_type;
    typedef typename _C_iter_base::pointer          pointer;
    typedef typename _C_iter_base::reference        reference;

    typedef random_access_iterator_tag               iterator_category;
    
    typedef __rw_deque_iter<value_type, difference_type,
                            value_type*, value_type&, allocator_type>
    _C_mutable_iter;

#ifdef _RWSTD_CXX11
    typedef __rw_deque_allocator<allocator_type, value_type*> _C_node_alloc_type;
#else
    typedef _RWSTD_REBIND (allocator_type, value_type*) _C_node_alloc_type;
#endif
    typedef typename _C_node_alloc_type::pointer       _C_node_pointer;

    
    static size_type _C_bufsize () {
        // deque only uses __rw_new_capacity to retrieve the minimum
        // allocation amount; this may be specialized to provide a
        // customized minimum amount
        typedef deque<_TypeT, _Allocator> _RWDeque;
        return _RWSTD_NEW_CAPACITY (_RWDeque, (const _RWDeque*)0, 0);
    }
    
#ifdef _RWSTDDEBUG

    __rw_deque_iter (): _C_cur (), _C_node () { /* invalid */ }

    ~__rw_deque_iter () {
        _C_cur  = pointer ();
        _C_node = _C_node_pointer ();   // invalidate
    }

#else   // if !defined (_RWSTDDEBUG)

#ifdef _RWSTD_CXX11
    __rw_deque_iter () : _C_cur (), _C_node () { }
#else
    __rw_deque_iter () { /* uninitialized */ }
#endif

#endif   // _RWSTDDEBUG


    // dummy first argument used to easily switch between
    // iterators with and without support for debugging
    __rw_deque_iter (pointer __cur, _C_node_pointer __node)
        : _C_cur (__cur), _C_node (__node) { }

    // no copy ctor other than the one below defined; will use
    // a compiler generated one if __rw_deque_iter != _C_mutable_iter
    __rw_deque_iter (const _C_mutable_iter &__rhs)
        : _C_cur (__rhs._C_cur),
          _C_node (__rhs._C_node) { }
    
    __rw_deque_iter& operator++ ();
    
    __rw_deque_iter& operator-- ();
    
    __rw_deque_iter operator++ (int) {
        __rw_deque_iter __tmp (*this);
        return ++*this, __tmp;
    }

    __rw_deque_iter operator-- (int) {
        __rw_deque_iter __tmp (*this);
        return --*this, __tmp;
    }

    __rw_deque_iter& operator+= (difference_type);
    
    __rw_deque_iter& operator-= (difference_type __n) {
        return *this += -__n;
    }

    __rw_deque_iter operator+ (difference_type __n) const {
        return __rw_deque_iter (*this) += __n;
    }

    __rw_deque_iter operator- (difference_type __n) const {
        return __rw_deque_iter (*this) -= __n;
    }

    reference operator* () const {
        return *_C_cur;
    }

    _RWSTD_OPERATOR_ARROW (pointer operator-> () const);
    
    reference operator[] (difference_type __n) const {
        return *(*this + __n);
    }

    // `cur' points at the curent element or is null (for the end iterator)
    // `node' points to the array containing the element or &cur (for end)
    pointer         _C_cur;
    _C_node_pointer _C_node;
};


template <class _TypeT, class _DiffT, class _Pointer,
          class _Reference, class _Allocator>
inline __rw_deque_iter<_TypeT, _DiffT, _Pointer, _Reference, _Allocator>&
__rw_deque_iter<_TypeT, _DiffT, _Pointer, _Reference, _Allocator>::
operator++ ()
{
    _RWSTD_ASSERT (pointer () != _C_cur);
    _RWSTD_ASSERT (_C_node_pointer () != _C_node);

    if (++_C_cur == *_C_node + _C_bufsize ())
        _C_cur = *++_C_node;

    return *this;
}


template <class _TypeT, class _DiffT, class _Pointer,
          class _Reference, class _Allocator>
inline __rw_deque_iter<_TypeT, _DiffT, _Pointer, _Reference, _Allocator>&
__rw_deque_iter<_TypeT, _DiffT, _Pointer, _Reference, _Allocator>::
operator-- ()
{
    _RWSTD_ASSERT (_C_node_pointer () != _C_node);

    if (_C_cur == *_C_node)
        _C_cur = *--_C_node + _C_bufsize ();

    --_C_cur;

    return *this;
}


template <class _TypeT, class _DiffT, class _Pointer,
          class _Reference, class _Allocator>
inline __rw_deque_iter<_TypeT, _DiffT, _Pointer, _Reference, _Allocator>&
__rw_deque_iter<_TypeT, _DiffT, _Pointer, _Reference, _Allocator>::
operator+= (difference_type __n)
{
#ifdef _RWSTD_CXX11
    if (!__n) return *this;
#endif
    _RWSTD_ASSERT (_C_node_pointer () != _C_node);

    const size_type __bufsize = _C_bufsize ();

    const difference_type __offset = __n + (_C_cur - *_C_node);

    if (__bufsize <= size_type (__offset)) {

        _RWSTD_ASSERT (__n != 0);

        const difference_type __jump = __offset >= 0 ? __offset / __bufsize
            : -difference_type ((__bufsize - __offset - 1) / __bufsize);

        _C_node += __jump;
        _C_cur   = *_C_node + (__offset - __jump * __bufsize);
    }
    else
        _C_cur += __n;

    _RWSTD_ASSERT (size_type (_C_cur - *_C_node) <= __bufsize);

    return *this;
}


// for symmetry
template <class _TypeT, class _DiffT, class _Ptr, class _Ref, class _Alloc>
inline __rw_deque_iter<_TypeT, _DiffT, _Ptr, _Ref, _Alloc>
operator+ (_DiffT                                                     __lhs,
           const __rw_deque_iter<_TypeT, _DiffT, _Ptr, _Ref, _Alloc> &__rhs)
{
    return __rhs + __lhs;
}


#define _RWSTD_DEQUE_ITER(n) \
        __rw_deque_iter<_TypeT, _DiffT, _Ptr##n, _Ref##n, _Alloc>


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline _DiffT
operator- (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    // _RWSTD_ASSERT_RANGE (__x, __y);
    typedef typename _RWSTD_DEQUE_ITER(1)::pointer _Pointer1;
    typedef typename _RWSTD_DEQUE_ITER(2)::pointer _Pointer2;

    if (_Pointer1 () == __x._C_cur && _Pointer2 () == __y._C_cur) {
        // __x and __y are end-iterator's of the empty deque's
        return _DiffT (0);
    }

    const _DiffT __bufsize = _DiffT (__x._C_bufsize ());

    return _DiffT (  __bufsize * (__x._C_node - __y._C_node - 1)
                   + (__x._C_cur - *__x._C_node)
                   + (*__y._C_node + __bufsize - __y._C_cur));
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator== (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return 0 == __x - __y;
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator< (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return __x - __y < 0;
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator!= (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return !(__x == __y);
}


template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator<= (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return !(__y < __x);
}

template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator>= (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return !(__x < __y);
}

template <class _TypeT, class _DiffT,
          class _Ptr1, class _Ref1, class _Ptr2, class _Ref2, class _Alloc>
inline bool
operator> (const _RWSTD_DEQUE_ITER(1) &__x, const _RWSTD_DEQUE_ITER(2) &__y)
{
    return __y < __x;
}


#undef _RWSTD_DEQUE_ITER


_EXPORT
template <class _TypeT, class _Allocator>
class deque: private _Allocator
{
public:

    typedef _TypeT                                    value_type;
    typedef _Allocator                                allocator_type;
#ifdef _RWSTD_CXX11
    typedef allocator_traits<allocator_type> _C_traits;
    typedef typename _C_traits::size_type size_type;
    typedef typename _C_traits::difference_type difference_type;
    typedef typename _C_traits::pointer pointer;
    typedef typename _C_traits::const_pointer const_pointer;
    typedef value_type& reference;
    typedef const value_type& const_reference;
    typedef value_type* _C_raw_pointer;
    typedef const value_type* _C_raw_const_pointer;
    typedef __rw_deque_allocator<allocator_type, value_type> _C_value_alloc_type;
#else
    typedef typename allocator_type::size_type       size_type;
    typedef typename allocator_type::difference_type difference_type;
    typedef typename allocator_type::pointer         pointer;
    typedef typename allocator_type::const_pointer   const_pointer;
    typedef typename allocator_type::reference       reference;
    typedef typename allocator_type::const_reference const_reference;

    typedef _RWSTD_ALLOC_TYPE (allocator_type, value_type) _C_value_alloc_type;

    typedef pointer _C_raw_pointer;
    typedef const_pointer _C_raw_const_pointer;
#endif

    // following two typedefs are used for convenience with debug iters
    typedef __rw_deque_iter<value_type, difference_type, _C_raw_pointer,
                            reference, allocator_type>         _C_deque_iter; 

    typedef __rw_deque_iter<value_type, difference_type, _C_raw_const_pointer,
                            const_reference, allocator_type>   _C_deque_citer;

#ifdef _RWSTD_CXX11
    typedef __rw_deque_allocator<allocator_type, value_type*> _C_node_alloc_type;
#else
    typedef _RWSTD_REBIND (allocator_type, value_type*) _C_node_alloc_type;
#endif

    typedef typename _C_node_alloc_type::pointer       _C_node_pointer;

#ifndef _RWSTD_NO_DEBUG_ITER

    typedef _RW::__rw_debug_iter<deque, _C_deque_iter, _C_deque_iter>
        iterator;
    
    typedef _RW::__rw_debug_iter<deque, _C_deque_citer, _C_deque_iter>
        const_iterator;
    
    iterator _C_make_iter (const _C_deque_iter &__iter) { 
        return iterator (*this, __iter);
    }

    const_iterator _C_make_iter (const _C_deque_citer &__citer) const {
        return const_iterator (*this, __citer);
    }

#else   // if defined (_RWSTD_NO_DEBUG_ITER)
    
    typedef _C_deque_iter  iterator;
    typedef _C_deque_citer const_iterator;
    
    iterator _C_make_iter (const _C_deque_iter &__iter) {
        return __iter;
    }

    const_iterator _C_make_iter (const _C_deque_citer &__citer) const {
        return __citer;
    }

#endif   // _RWSTD_NO_DEBUG_ITER

    size_type _C_vecsize (size_type __nodes) const {
        return _RWSTD_NEW_CAPACITY (deque, this, __nodes);
    }

    static size_type _C_bufsize () {
        return _C_deque_iter::_C_bufsize ();
    }

#ifndef _RWSTD_NO_CLASS_PARTIAL_SPEC 

    typedef _STD::reverse_iterator<const_iterator> const_reverse_iterator;
    typedef _STD::reverse_iterator<iterator>       reverse_iterator;

#else   // if defined (_RWSTD_NO_CLASS_PARTIAL_SPEC)

    typedef _STD::reverse_iterator<const_iterator, random_access_iterator_tag,
                                   value_type, const_reference, _C_raw_const_pointer,
                                   difference_type>
        const_reverse_iterator;

    typedef _STD::reverse_iterator<iterator, random_access_iterator_tag,
                                   value_type, reference, _C_raw_pointer,
                                   difference_type>
        reverse_iterator;

#endif   // _RWSTD_NO_CLASS_PARTIAL_SPEC 

#ifdef _RWSTD_CXX11
    deque () noexcept (is_nothrow_default_constructible<allocator_type>::value)
        : allocator_type () { _C_init (); }
    explicit deque (const allocator_type& __a) noexcept : allocator_type (__a) { _C_init (); }
    explicit deque (size_type __n, const allocator_type& __a = allocator_type ())
        : deque (__a) {
        _C_check_growth (__n);
        _TRY { while (__n--) emplace_back (); }
        _CATCH (...) { clear (); _RETHROW; }
    }
    deque (size_type __n, const_reference __value, const allocator_type& __a = allocator_type ())
        : deque (__a) { assign (__n, __value); }
    template <class _InputIter, class = decltype(static_cast<void>(*std::declval<_InputIter&>()),
                                                       static_cast<void>(++std::declval<_InputIter&>()))>
    deque (_InputIter __first, _InputIter __last, const allocator_type& __a = allocator_type ())
        : deque (__a) {
        _TRY { for (; __first != __last; ++__first) emplace_back (*__first); }
        _CATCH (...) { clear (); _RETHROW; }
    }
    deque (const deque& __rhs)
        : deque (__rhs, _C_traits::select_on_container_copy_construction (__rhs.get_allocator ())) { }
    deque (const deque& __rhs, const allocator_type& __a)
        : deque (__rhs.begin (), __rhs.end (), __a) { }
    deque (deque&& __rhs) noexcept (is_nothrow_move_constructible<allocator_type>::value)
        : allocator_type (std::move (static_cast<allocator_type&>(__rhs))) {
        _C_init (); _C_swap_data (__rhs);
    }
    deque (deque&& __rhs, const allocator_type& __a) : deque (__a) {
        if (__a == __rhs.get_allocator ()) _C_swap_data (__rhs);
        else {
            _TRY { for (iterator __i = __rhs.begin (); __i != __rhs.end (); ++__i) emplace_back (std::move (*__i)); }
            _CATCH (...) { clear (); _RETHROW; }
        }
    }
    deque (initializer_list<value_type> __values, const allocator_type& __a = allocator_type ())
        : deque (__values.begin (), __values.end (), __a) { }
    ~deque () { clear (); }
    deque& operator= (const deque& __rhs) {
        if (this != &__rhs) {
            _C_copy_allocator (__rhs, typename _C_traits::propagate_on_container_copy_assignment ());
            assign (__rhs.begin (), __rhs.end ());
        }
        return *this;
    }
    deque& operator= (deque&& __rhs)
        noexcept (_C_traits::propagate_on_container_move_assignment::value
                  && is_nothrow_move_assignable<allocator_type>::value) {
        if (this != &__rhs) _C_move_assign (__rhs, typename _C_traits::propagate_on_container_move_assignment ());
        return *this;
    }
    deque& operator= (initializer_list<value_type> __values) { assign (__values); return *this; }
    template <class _InputIter, class = decltype(static_cast<void>(*std::declval<_InputIter&>()),
                                                       static_cast<void>(++std::declval<_InputIter&>()))>
    void assign (_InputIter __first, _InputIter __last) {
        iterator __out = begin ();
        for (; __out != end () && __first != __last; static_cast<void>(++__out), ++__first) *__out = *__first;
        if (__first == __last) erase (__out, end ());
        else for (; __first != __last; ++__first) emplace_back (*__first);
    }
    void assign (size_type __n, const_reference __value) {
        _RWSTD_REQUIRES (__n <= max_size (),
                         (_RWSTD_ERROR_LENGTH_ERROR, _RWSTD_FUNC("deque assign"),
                          static_cast<unsigned>(__n), static_cast<unsigned>(max_size())));
        deque __tmp (get_allocator ());
        while (__n--) __tmp.emplace_back (__value);
        _C_swap_data (__tmp);
    }
    void assign (initializer_list<value_type> __values) { assign (__values.begin (), __values.end ()); }
#else
    explicit
    deque (const allocator_type &__alloc = allocator_type ())
      : allocator_type (__alloc) {
        _C_init ();
    }

    explicit
    deque (size_type __n, const_reference __x = value_type (), 
           const allocator_type &__alloc = allocator_type ())
        : allocator_type (__alloc) {
        _C_init ();
        assign (__n, __x);
    }

    template <class _InputIter>
    deque (_InputIter __first, _InputIter __last,
           const allocator_type &__alloc = allocator_type ())
        : allocator_type (__alloc) {
        _C_init ();
        assign (__first, __last);
    }

    deque (const deque &__rhs)
        : allocator_type (__rhs.get_allocator ()) {
        _C_init ();
        assign (__rhs.begin (), __rhs.end ());
    }

    ~deque () {
        clear ();
    }

    deque& operator= (const deque&);

    template <class _InputIter>
    void assign (_InputIter __first, _InputIter __last) {
        // dispatch either to a range assign or to an assign with repetition
        _C_assign (__first, __last, _RWSTD_DISPATCH (_InputIter));
    }

    void assign (size_type __n, const_reference __x) {
        _C_assign_n (__n, __x);
    }

#endif

    allocator_type get_allocator () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return *this;
    }

    iterator begin ()
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return _C_make_iter (_C_beg);
    }

    const_iterator begin () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return _C_make_iter (_C_beg);
    }

    iterator end ()
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return _C_make_iter (_C_end);
    }

    const_iterator end () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return _C_make_iter (_C_end);
    }

    reverse_iterator rbegin ()
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return reverse_iterator (end ());
    }

    const_reverse_iterator rbegin () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return const_reverse_iterator (end ());
    }
    
    reverse_iterator rend ()
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return reverse_iterator (begin ());
    }

    const_reverse_iterator rend () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return const_reverse_iterator (begin ());
    }

#ifdef _RWSTD_CXX11
    const_iterator cbegin () const noexcept { return begin (); }
    const_iterator cend () const noexcept { return end (); }
    const_reverse_iterator crbegin () const noexcept { return rbegin (); }
    const_reverse_iterator crend () const noexcept { return rend (); }
#endif

    bool empty () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return    _C_beg._C_node == _C_end._C_node
               && _C_beg._C_cur == _C_end._C_cur;
    }

    size_type size () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
        return empty () ? 0 : size_type (end () - begin ());
    }

    size_type max_size () const
#ifdef _RWSTD_CXX11
        noexcept
#endif
    {
#ifdef _RWSTD_CXX11
        return (std::min) (_C_traits::max_size (get_allocator ()),
                          size_type ((numeric_limits<difference_type>::max) ()));
#else
        return _RWSTD_VALUE_ALLOC (_C_value_alloc_type, *this, max_size ());
#endif
    }

#ifdef _RWSTD_CXX11
    void resize (size_type __n) {
        size_type __old = size ();
        if (__n < __old) erase (cbegin () + __n, cend ());
        else {
            _TRY { while (size () != __n) emplace_back (); }
            _CATCH (...) { while (size () != __old) pop_back (); _RETHROW; }
        }
    }
    void resize (size_type __n, const_reference __value) {
        if (__n < size ()) erase (cbegin () + __n, cend ());
        else insert (cend (), __n - size (), __value);
    }
    void shrink_to_fit () noexcept {
        if (empty ()) return;
        size_type __used = size_type (_C_end._C_node - _C_beg._C_node + 1);
        if (__used == _C_node_size) return;
        _TRY {
            _C_node_alloc_type __alloc (get_allocator ());
            _C_node_pointer __map = __alloc.allocate (__used + 2);
            __map[0] = __map[__used + 1] = _C_raw_pointer ();
